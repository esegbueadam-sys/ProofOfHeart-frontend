# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# build & production outputs (monorepo wide)
dist/
**/dist/
build/
**/build/
.next/
out/

# testing & coverage (monorepo wide)
coverage/
**/coverage/
test-results/
**/test-results/
playwright-report/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*
!.env.example

# vercel
.vercel

# typescript & docs
*.tsbuildinfo
next-env.d.ts
fix.md
pr.md
PR_CONTENT.md
PR_DESCRIPTION_*.md
.codex

# CI artefacts
bundle-size-summary.json
npm-audit-report.json
npm-audit-temp.json